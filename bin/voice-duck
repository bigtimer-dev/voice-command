#!/bin/bash
# voice-duck duck|restore : lower playing audio (music, videos) while you give a
# voice command, then put it back. Per-app, so a stream Spotify recreates
# meanwhile (new song) is restored too and never stays quiet.
STATE="${XDG_RUNTIME_DIR:-/tmp}/voice-command/duck.tsv"
LEVEL=${VOICE_DUCK_LEVEL:-20}          # percent of the current volume while listening
SELF='^(paplay|pw-play|pw-cat|pw-record|piper|python3?|notify-send)$'
mkdir -p "${STATE%/*}"

streams() {   # index <TAB> app key <TAB> volume% , playing streams only
  pactl -f json list sink-inputs 2>/dev/null | jq -r '.[] | select(.corked == false)
    | [.index, (.properties["application.process.binary"] // .properties["application.name"] // "?"),
       (.volume | to_entries[0].value.value_percent | rtrimstr("%"))] | @tsv'
}

case ${1:-} in
  duck)
    [[ -s $STATE ]] && exit 0          # already ducked
    : >"$STATE"
    while IFS=$'\t' read -r idx app vol; do
      [[ $app =~ $SELF ]] && continue
      printf '%s\t%s\n' "$app" "$vol" >>"$STATE"
      pactl set-sink-input-volume "$idx" "$(( vol * LEVEL / 100 ))%"
    done < <(streams) ;;
  restore)
    [[ -s $STATE ]] || { rm -f "$STATE"; exit 0; }
    while IFS=$'\t' read -r idx app _; do
      vol=$(awk -F'\t' -v a="$app" '$1 == a { print $2; exit }' "$STATE")
      [[ -n $vol ]] && pactl set-sink-input-volume "$idx" "$vol%"
    done < <(pactl -f json list sink-inputs 2>/dev/null | jq -r '.[] | [.index,
      (.properties["application.process.binary"] // .properties["application.name"] // "?"), 0] | @tsv')
    rm -f "$STATE" ;;
  *) echo "usage: voice-duck duck|restore" >&2; exit 2 ;;
esac
