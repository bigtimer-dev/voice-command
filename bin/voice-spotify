#!/usr/bin/env python3
"""voice-spotify "what to play" [--dry]

Finds the best match with the Spotify Web API (search only, app credentials,
no account login) and plays it in the desktop app through MPRIS OpenUri.
Spotify's own Autoplay keeps going with similar songs after it.
Without credentials, or if the search fails, it opens the search page instead.

Credentials: ~/.config/voice-commands/spotify.env  (chmod 600)
  SPOTIFY_CLIENT_ID=...
  SPOTIFY_CLIENT_SECRET=...
"""
import base64, difflib, json, os, re, subprocess, sys, time, unicodedata, urllib.parse, urllib.request

ENV = os.path.expanduser("~/.config/voice-commands/spotify.env")
TOKEN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "voice-command", "spotify-token.json")
BUS = "org.mpris.MediaPlayer2.spotify"


def notify(msg):
    subprocess.run(["notify-send", "-a", "Voice command", "-t", "4000", "Voice command", msg],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def creds():
    d = {}
    try:
        for line in open(ENV):
            k, _, v = line.strip().partition("=")
            d[k.strip()] = v.strip().strip('"\'')
    except OSError:
        pass
    return d.get("SPOTIFY_CLIENT_ID"), d.get("SPOTIFY_CLIENT_SECRET")


def token(cid, secret):
    try:
        t = json.load(open(TOKEN))
        if t["expires"] > time.time() + 60:
            return t["access_token"]
    except (OSError, ValueError, KeyError):
        pass
    req = urllib.request.Request(
        "https://accounts.spotify.com/api/token", data=b"grant_type=client_credentials",
        headers={"Authorization": "Basic " + base64.b64encode(f"{cid}:{secret}".encode()).decode(),
                 "Content-Type": "application/x-www-form-urlencoded"})
    t = json.load(urllib.request.urlopen(req, timeout=8))
    t["expires"] = time.time() + t.get("expires_in", 3600)
    os.makedirs(os.path.dirname(TOKEN), exist_ok=True)
    fd = os.open(TOKEN, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(t, f)
    return t["access_token"]


def simple(s):
    s = unicodedata.normalize("NFKD", s).encode("ascii", "ignore").decode().lower()
    return re.sub(r"[^a-z0-9]+", " ", s).strip()


def search(q, tok):
    url = "https://api.spotify.com/v1/search?" + urllib.parse.urlencode(
        {"q": q, "type": "track,artist,playlist", "limit": 5})
    r = json.load(urllib.request.urlopen(
        urllib.request.Request(url, headers={"Authorization": "Bearer " + tok}), timeout=8))
    tracks = [t for t in r.get("tracks", {}).get("items", []) if t]
    artists = [a for a in r.get("artists", {}).get("items", []) if a]
    playlists = [p for p in r.get("playlists", {}).get("items", []) if p]
    sq = simple(q)
    # "rammstein" (or a misheard "rainstein") -> the artist; play their top song
    an = simple(artists[0]["name"]) if artists else ""
    close = bool(an) and abs(len(an) - len(sq)) <= 2 and difflib.SequenceMatcher(None, an, sq).ratio() >= 0.75
    if artists and (close or not tracks):
        a = artists[0]
        mine = [t for t in tracks if any(x["id"] == a["id"] for x in t["artists"])]
        if not mine:
            url = "https://api.spotify.com/v1/search?" + urllib.parse.urlencode(
                {"q": f'artist:"{a["name"]}"', "type": "track", "limit": 10})
            rr = json.load(urllib.request.urlopen(
                urllib.request.Request(url, headers={"Authorization": "Bearer " + tok}), timeout=8))
            mine = [t for t in rr["tracks"]["items"] if t and any(x["id"] == a["id"] for x in t["artists"])]
        if mine:
            t = max(mine, key=lambda t: t.get("popularity") or 0)
            return t["uri"], f'{t["name"]} – {a["name"]}'
    # "music to sleep" / "lofi beats" -> a playlist if its name fits better than any track
    if playlists and sq and sq in simple(playlists[0]["name"]) and not (tracks and sq in simple(tracks[0]["name"])):
        p = playlists[0]
        return p["uri"], f'playlist “{p["name"]}”'
    if tracks:
        t = tracks[0]
        return t["uri"], f'{t["name"]} – {t["artists"][0]["name"]}'
    return None, None


def running():
    return subprocess.run(["busctl", "--user", "status", BUS], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0


def play(uri):
    if not running():
        subprocess.Popen(["setsid", "uwsm-app", "--", "/usr/bin/spotify"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(100):                        # up to 20 s for the app to start
            if running():
                time.sleep(2.5)                     # let it finish loading
                break
            time.sleep(0.2)
    subprocess.run(["dbus-send", "--session", "--type=method_call", f"--dest={BUS}",
                    "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player.OpenUri",
                    f"string:{uri}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def open_search(q):
    uri = "spotify:search:" + urllib.parse.quote(q)
    if running():
        subprocess.Popen(["spotify", f"--uri={uri}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["omarchy-launch-spotify"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        subprocess.Popen(["setsid", "uwsm-app", "--", "/usr/bin/spotify", f"--uri={uri}"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    q = sys.argv[1].strip()
    dry = "--dry" in sys.argv
    cid, secret = creds()
    uri = label = None
    if cid and secret:
        try:
            uri, label = search(q, token(cid, secret))
        except Exception as e:                       # network, bad credentials...
            print("search failed:", e, file=sys.stderr)
    if dry:
        print(uri, label); return
    if uri:
        notify(f"Playing {label}")
        play(uri)
    else:
        open_search(q)


if __name__ == "__main__":
    main()
