[Unit]
Description=Wake word "hey jarvis" for voice-command (offline, openWakeWord)
# Part of the desktop session: if Hyprland restarts (crash, re-login), the
# listener restarts too and picks up the new HYPRLAND_INSTANCE_SIGNATURE.
# Otherwise hyprctl commands (close window, workspaces) fail with a stale socket.
PartOf=graphical-session.target
After=graphical-session.target pipewire.service superwhisper.service
Wants=pipewire.service

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.local/share/wake-word/venv/bin/python -I %h/.local/share/wake-word/wake_word.py
Restart=on-failure
RestartSec=3
Nice=5
MemoryMax=400M

[Install]
WantedBy=graphical-session.target
